# .env.example — copy to `.env` and fill in. `.env` is gitignored and must
# never be committed; the CI workflow has a step that fails if it ever is.
#
# The private key itself does NOT belong here. It lives as a .p8 file under
# `keys/` (also gitignored) and is referenced by path below.

# ── Source PostgreSQL (the CDC source Debezium reads from) ──────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Used by tests/load_to_postgres.py, e.g. postgresql://user:pass@localhost:5432/db
DATABASE_URL=

# ── Snowflake (RSA key-pair authentication) ─────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Path INSIDE the containers — ./keys is bind-mounted at /secrets:ro, and dbt
# and Dagster are what consume it. register_connectors.sh runs on the host,
# where /secrets does not exist, so it tries this path first and falls back to
# the same filename under keys/.
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/rsa_key.p8
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_URL=

# NOTE: SNOWFLAKE_PRIVATE_KEY (the whole PKCS8 body as a string) is deliberately
# absent. Until 2026-08-11 the key lived here a second time, because the Kafka
# connector and scripts/sync_metadata.py need it as a string. The duplication
# cost a leaked key and turned rotation into a five-location procedure. Both
# consumers now derive the string from the .p8 file. Setting it still works, for
# environments that have not migrated.

# ── Kafka ───────────────────────────────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ── dbt ─────────────────────────────────────────────────────────────────────
DBT_TARGET=dev

# ── Dagster storage (the dedicated Postgres of ADR-0018, not the CDC source) ─
DAGSTER_PG_DB=
DAGSTER_PG_USER=
DAGSTER_PG_PASSWORD=
