{
  "name": "sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",
    "tasks.max": "4",

    "topics": "pg.public.payment_events,pg.public.orders,pg.public.order_items,pg.public.driver_shifts,pg.public.search_events,pg.public.recommendations,pg.public.users_mongo,pg.public.users_mssql,pg.public.restaurants,pg.public.drivers",

    "snowflake.url.name": "${SNOWFLAKE_URL}",
    "snowflake.user.name": "${SNOWFLAKE_USER}",
    "snowflake.private.key": "${SNOWFLAKE_PRIVATE_KEY}",
    "snowflake.database.name": "${SNOWFLAKE_DATABASE}",
    "snowflake.schema.name": "BRONZE",
    "snowflake.role.name": "${SNOWFLAKE_ROLE}",

    "snowflake.topic2table.map": "pg.public.payment_events:PAYMENT_EVENTS,pg.public.orders:ORDERS,pg.public.order_items:ORDER_ITEMS,pg.public.driver_shifts:DRIVER_SHIFTS,pg.public.search_events:SEARCH_EVENTS,pg.public.recommendations:RECOMMENDATIONS,pg.public.users_mongo:USERS_MONGO,pg.public.users_mssql:USERS_MSSQL,pg.public.restaurants:RESTAURANTS,pg.public.drivers:DRIVERS",

    "snowflake.enable.schematization": "true",
    "snowflake.validation": "client_side",
    "snowflake.compatibility.enable.column.identifier.normalization": "true",
    "snowflake.compatibility.enable.autogenerated.table.name.sanitization": "true",
    "snowflake.streaming.classic.offset.migration": "skip",

    "consumer.override.auto.offset.reset": "earliest",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081"
  }
}
